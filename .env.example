#--------------------------------------------------------------------
# .env.example - Oficina del Agua
#
# Copia este archivo como ".env" y ajusta los valores a tu entorno
# local. NUNCA subas tu archivo ".env" real al repositorio: contiene
# credenciales y ya esta ignorado en .gitignore.
#
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows / CMD)
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENTORNO
#--------------------------------------------------------------------
# En tu maquina local usa "development" para ver los errores completos
# en pantalla. En el servidor de produccion debe quedar "production".

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# URL base de tu entorno local. En Laragon normalmente es algo como
# http://localhost:8080/ o http://proyecto-agua-keko.test/ segun como
# lo tengas configurado.

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# BASE DE DATOS
#--------------------------------------------------------------------
# Datos de conexion a tu MySQL/MariaDB local (Laragon/XAMPP). Reemplaza
# estos valores de ejemplo con tu usuario y contrasena reales; no dejes
# el placeholder tal cual en tu .env local.

database.default.hostname = tu_host
database.default.database = tu_base_de_datos
database.default.username = tu_usuario
database.default.password = tu_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRIPTACION
#--------------------------------------------------------------------
# Requerido por CodeIgniter para encriptar datos sensibles (por ejemplo
# el cifrado de sesiones o cookies, si se usa). Genera la tuya con:
#   php spark key:generate
# y pega aqui el valor que te genere (no uses este placeholder tal cual).

encryption.key = hex2bin:pon_aqui_tu_clave_generada

#--------------------------------------------------------------------
# SESION
#--------------------------------------------------------------------
# Valores por defecto de CodeIgniter, normalmente no hace falta tocarlos
# en desarrollo local.

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# Nivel de detalle de los logs en writable/logs/. 4 = Errors, warnings,
# notices, deprecations (valor por defecto usado en este proyecto).

logger.threshold = 4